# Copy to `.env`. Do not commit `.env`.
# Public origin is always https://alsatport.com (auth callbacks included).

AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Optional 32+ char key for TCKN/address AES-256-GCM. Falls back to AUTH_SECRET if unset.
ENCRYPTION_KEY=
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/alsatport
APP_URL=https://alsatport.com
NEXT_PUBLIC_APP_URL=https://alsatport.com
# Alias used by some hosts; production callbacks always use https://alsatport.com
NEXTAUTH_URL=https://alsatport.com
ADMIN_EMAIL=

# Google Cloud Console → OAuth 2.0 Client (Web application)
# Redirect: https://alsatport.com/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers → Facebook Login
# Redirect: https://alsatport.com/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Apple Developer → Services ID + Key
# Redirect: https://alsatport.com/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

MAIL_FROM=AlsatPort Destek <destek@alsatport.com>
# Hostinger (MX mx1.hostinger.com). SMTP_PASS = destek@alsatport.com mailbox password.
SMTP_HOST=smtp.hostinger.com
# Hostinger Professional (Titan) fallback is tried in code: smtp.titan.email
SMTP_PORT=465
SMTP_USER=destek@alsatport.com
SMTP_PASS=
SMTP_SECURE=true
RESEND_API_KEY=
MAIL_DEBUG=

BLOB_READ_WRITE_TOKEN=

# Optional nude-content API (otherwise a local skin-tone heuristic is used).
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# PayTR webhook: https://alsatport.com/api/payments/webhook/paytr
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=0

# Set to 0 only when paid packages / PayTR checkout should run again.
# PAYMENTS_PAUSED is currently hardcoded true in src/lib/campaign.ts.

# Google reCAPTCHA v3 (Admin Console keys). Site key is public; keep the secret off the client.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
