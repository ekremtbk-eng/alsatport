<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AlsatPort" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand_green</item>
        <item name="android:colorAccent">@color/brand_green</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/navigation_bar</item>
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- Translucent so the browser's own splash/page appears without a white flash in between. -->
    <style name="Theme.AlsatPort.Launcher" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/navigation_bar</item>
    </style>
</resources>
