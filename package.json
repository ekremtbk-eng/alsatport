{
  "name": "alsatport",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "prisma generate && tsx scripts/check-vehicle-brand-search-index.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:maintain": "node scripts/prisma-deploy.mjs",
    "check:vehicle-search-index": "tsx scripts/check-vehicle-brand-search-index.ts",
    "build:brand-marks": "tsx scripts/optimize-manual-brand-marks.ts && tsx scripts/build-brand-marks.ts",
    "test:brand-marks": "tsx scripts/test-brand-marks.ts",
    "test:security": "tsx scripts/test-security.ts",
    "test:recaptcha": "tsx scripts/test-recaptcha.ts",
    "test:mobile-filters": "tsx scripts/test-mobile-filters.ts",
    "test:markets": "tsx scripts/test-markets.ts",
    "db:setup": "prisma migrate deploy && prisma db seed"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.544.0",
    "next": "15.5.28",
    "nodemailer": "^10.0.11",
    "qrcode-generator": "^1.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "simple-icons": "^16.35.0",
    "tsx": "^4.20.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "8.5.30",
    "source-map-js": "1.2.2",
    "deepmerge-ts": "8.0.2"
  }
}
